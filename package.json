  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@vercel/analytics": "2.0.1",
    "astro": "7.4.5",
    "chart.js": "4.6.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.3",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "wawoff2": "2.0.1"
  }
}
