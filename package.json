{
  "name": "inlay.live",
  "private": true,
  "version": "0.0.0",
  "description": "The website for Inlay, a Markdown editor for macOS that runs the HTML, SVG, CSS and JavaScript inside your documents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
