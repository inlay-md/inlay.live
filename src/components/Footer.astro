---
// SPDX-License-Identifier: Apache-2.0
import { site } from '../data/site';
import Logo from './Logo.astro';
---

<footer class="footer">
  <div class="footer__inner container">
    <span class="footer__brand"><Logo on="light" size={20} wordmark /></span>
    <span>{site.copyright} · Apache-2.0</span>
    <span class="footer__spacer"></span>
    <a href={site.repo} rel="noopener">GitHub</a>
    <a href={site.trademarks} rel="noopener">Trademarks</a>
    <a href={site.notices} rel="noopener">Acknowledgements</a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    padding-top: 28px;
    padding-bottom: 28px;
    font-size: 13px;
    color: var(--muted);
  }
  .footer__brand {
    color: var(--ink);
  }
  .footer__spacer {
    flex: 1;
  }
  .footer a {
    color: var(--muted);
    text-decoration: none;
  }
  .footer a:hover {
    color: var(--ink);
  }
</style>
