---
// SPDX-License-Identifier: Apache-2.0
import { alsoShips, features } from '../data/features';

const icons: Record<string, string> = {
  render:
    '<path d="M4 12s3-6 8-6 8 6 8 6-3 6-8 6-8-6-8-6z"></path><circle cx="12" cy="12" r="2.5" fill="#1F7A7A" stroke="none"></circle>',
  offline:
    '<path d="M7 17a4 4 0 0 1-.9-7.9A5.5 5.5 0 0 1 16.7 8 4.5 4.5 0 0 1 17 17H7z"></path><path d="M3 3l18 18" stroke="#9A6E1A"></path>',
  islands:
    '<path d="M4 20h4l10-10-4-4L4 16v4z"></path><rect x="14" y="15" width="7" height="6" rx="1" fill="#141A22"></rect><path d="M15.5 16.5h4M15.5 18.5h2.5" stroke="#E0A83A" stroke-width="1"></path>',
  split:
    '<rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M12 4v16"></path><path d="M6 9h3M6 12h3M6 15h2" stroke="#9A6E1A"></path><path d="M15 9h3M15 12h3" stroke="#1F7A7A"></path>',
  quicklook:
    '<circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path><rect x="8" y="9" width="6" height="4" rx="1" fill="#141A22"></rect>',
  sacred:
    '<rect x="5" y="3" width="14" height="18" rx="2"></rect><path d="M9 12h6M9 15h6" stroke="#9A6E1A"></path><path d="M9 8h6"></path>',
};
---

<section id="features" class="features container" aria-labelledby="features-title">
  <div class="features__intro">
    <div class="eyebrow">What ships in v1</div>
    <h2 id="features-title" class="h2">An editor that respects the page and the file.</h2>
  </div>

  <div class="features__grid">
    {
      features.map((f) => (
        <article class:list={['card', { 'card--highlight': f.highlight }]}>
          <svg
            viewBox="0 0 24 24"
            width="28"
            height="28"
            fill="none"
            stroke="#141A22"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={icons[f.id]}
          />
          <h3 class="card__title">{f.title}</h3>
          <p class="card__body">{f.body}</p>
        </article>
      ))
    }
  </div>

  <p class="features__also">
    <span class="features__also-label">Also:</span>
    {alsoShips.map((item, i) => (
      <>
        {i > 0 && <span class="features__dot" aria-hidden="true">·</span>}
        <span>{item}</span>
      </>
    ))}
  </p>
</section>

<style>
  .features {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 48px;
    padding-bottom: 48px;
  }
  .features__intro {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .features__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
  }
  .card {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .card--highlight {
    border-left: 3px solid var(--brass-bright);
  }
  .card__title {
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.02em;
  }
  .card__body {
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
  }
  .features__also {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    font-size: 14px;
    color: var(--muted);
  }
  .features__also-label {
    font-weight: 600;
    color: var(--ink);
  }
  .features__dot {
    color: var(--line-2);
  }
</style>
