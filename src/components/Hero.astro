---
// SPDX-License-Identifier: Apache-2.0
import { site } from '../data/site';
---

<section id="top" class="hero container">
  <div class="hero__copy">
    <span class="hero__pill">For macOS 14+ · in development</span>
    <h1 class="hero__title">{site.tagline}</h1>
    <p class="hero__lede">
      Inlay is a Mac editor that renders the HTML, SVG, CSS and JavaScript inside your documents the
      way a browser would. And it never rewrites your file behind your back.
    </p>
    <div class="hero__actions">
      <a class="button button--brass" href="#waitlist">Join the waitlist</a>
      <a class="button button--ghost-on-ink" href={site.repo} rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6l-5 6 5 6"></path><path d="M16 6l5 6-5 6"></path></svg>
        Apache-2.0 on GitHub
      </a>
    </div>
  </div>

  <div class="hero__window window" aria-hidden="true">
    <div class="window__bar">
      <div class="window__lights"><span></span><span></span><span></span></div>
      <span class="window__title">Quarterly report.md</span>
      <div class="modes"><span class="modes__on">Read</span><span>Edit</span><span>Source</span><span>Split</span></div>
      <span class="scripts-on"><span class="scripts-on__dot"></span>Scripts on</span>
    </div>
    <div class="hero__doc">
      <div class="hero__prose">
        <div class="hero__doc-title">Quarterly report</div>
        <div class="hero__doc-text">
          Revenue grew in every region, with APAC closing its first two enterprise accounts. The chart on
          the right is drawn by Chart.js inside this document.
        </div>
        <div class="placeholder-line" style="width: 80%"></div>
        <div class="placeholder-line" style="width: 60%"></div>
      </div>
      <div class="hero__tile">
        <span class="badge-live hero__live">live</span>
        <svg viewBox="0 0 400 170" width="100%" height="170">
          <g stroke="#DDE1E7"><path d="M30 140H390"></path><path d="M30 100H390"></path><path d="M30 60H390"></path><path d="M30 20H390"></path></g>
          <rect x="60" y="92" width="34" height="48" rx="3" fill="#B9C1CC"></rect>
          <rect x="100" y="68" width="34" height="72" rx="3" fill="#1F7A7A"></rect>
          <rect x="180" y="76" width="34" height="64" rx="3" fill="#B9C1CC"></rect>
          <rect x="220" y="20" width="34" height="120" rx="3" fill="#1F7A7A"></rect>
          <rect x="300" y="124" width="34" height="16" rx="3" fill="#B9C1CC"></rect>
          <rect x="340" y="84" width="34" height="56" rx="3" fill="#1F7A7A"></rect>
          <g font-size="11" fill="#141A22" font-family="Inter Variable, Inter, sans-serif" text-anchor="middle"><text x="97" y="160">EU</text><text x="217" y="160">US</text><text x="337" y="160">APAC</text></g>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: 56px;
  }
  .hero__copy {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .hero__pill {
    align-self: flex-start;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brass-bright);
    border: 1px solid var(--ink-3);
    border-radius: 999px;
    padding: 6px 12px;
  }
  .hero__title {
    font-weight: 700;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .hero__lede {
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.5;
    color: var(--text-on-ink);
    max-width: 640px;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__window {
    border-radius: 14px 14px 0 0;
    box-shadow: 0 -10px 60px rgba(0, 0, 0, 0.35);
    max-height: 420px;
  }
  .modes {
    display: flex;
    background: var(--paper-3);
    border-radius: 6px;
    padding: 2px;
    font-size: 11px;
  }
  .modes span {
    padding: 3px 9px;
    border-radius: 4px;
  }
  .modes__on {
    background: var(--paper);
    font-weight: 500;
    box-shadow: 0 1px 2px rgba(20, 26, 34, 0.18);
  }
  .scripts-on {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 22px;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--verdigris-bg);
    color: var(--verdigris-text);
    font-size: 11px;
    font-weight: 500;
  }
  .scripts-on__dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--verdigris);
  }
  .hero__doc {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    padding: 28px 32px 0;
  }
  .hero__prose {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .hero__doc-title {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .hero__doc-text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .hero__tile {
    flex: 1 1 320px;
    min-width: 0;
    position: relative;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 16px;
  }
  .hero__live {
    position: absolute;
    top: 8px;
    right: 10px;
    height: 18px;
    font-size: 10px;
  }
  @media (max-width: 600px) {
    .hero {
      padding-top: 36px;
    }
    .modes,
    .scripts-on {
      display: none;
    }
    .hero__doc {
      padding: 20px 20px 0;
    }
  }
</style>
